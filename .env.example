# MeetFlow Environment Configuration Example
# Copy this file to .env and configure your values

# Project Info
PROJECT_NAME="MeetFlow API"
ENVIRONMENT="development"
DEBUG=True

# API Configuration
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration
# Default is local SQLite in the backend directory
DATABASE_URL="sqlite:///./meetflow.db"

# Storage Settings
UPLOAD_DIR="./uploads"

# Providers
# Transcription provider: "mock" (default local synthetic) or "gemini" (Google Gemini 3.5 Transcribe)
TRANSCRIPTION_PROVIDER="mock"
# Extraction provider: "mock" (default local regex) or "gemma" (real hosted Gemma via Gemini API)
EXTRACTION_PROVIDER="mock"
EXECUTION_PROVIDER="mock"

# Google Gemini API Configuration (used for both transcription and workflow extraction)
# Place your Google Gemini API key here (never commit your actual key)
GEMINI_API_KEY=""

# Model Configurations
# Transcription speech-to-text model
GEMINI_TRANSCRIPTION_MODEL="gemini-3.5-transcribe"
# Workflow extraction LLM model
GEMMA_MODEL="gemma-4-26b-a4b-it"
